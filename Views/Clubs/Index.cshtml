@model IReadOnlyList<SwimSuite.Models.Club>

@{
    ViewData["Title"] = "Clubs";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Clubs</h1>
        <p class="text-muted mb-0">Manage tenant clubs for SwimSuite.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create club</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No clubs have been created yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Registration</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var club in Model)
                {
                    <tr>
                        <td>@club.Name</td>
                        <td>@(club.RegistrationNumber ?? "-")</td>
                        <td>@(club.Email ?? "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@club.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
